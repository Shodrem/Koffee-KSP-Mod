// Experiment Manager: explicit Engineer assignment, no ElectricCharge requirement.
PART
{
    name = SHOExperimentManagerEML125
    module = Part
    author = SHO Aerospace

    MODEL
    {
        model = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/Experiment_Manager_EML125
    }
    scale = 1
    rescaleFactor = 1

    // Exported transforms use local +Z as the outward stack-node direction.
    NODE
    {
        name = top
        transform = attach_North
        size = 1
        method = FIXED_JOINT
    }
    NODE
    {
        name = bottom
        transform = attach_South
        size = 1
        method = FIXED_JOINT
    }
    attachRules = 1,0,1,1,0

    // Space Exploration is a technology node; Science is the stock editor category.
    TechRequired = spaceExploration
    entryCost = 2800
    cost = 450
    category = Science
    subcategory = 0
    title = #LOC_Koffee_ExperimentManagerEML125_Title
    manufacturer = #LOC_Koffee_ExperimentManagerEML125_Manufacturer
    description = #LOC_Koffee_ExperimentManagerEML125_Description
    tags = #LOC_Koffee_ExperimentManagerEML125_Tags

    // Balance from Squad/Parts/Command/probeCoreOcto_v2/probeCoreOcto_v2.cfg.
    mass = 0.1
    dragModelType = default
    maximum_drag = 0.2
    minimum_drag = 0.15
    angularDrag = 1.5
    crashTolerance = 12
    maxTemp = 1200
    explosionPotential = 0
    bulkheadProfiles = size1

    MODULE
    {
        name = ModuleKoffeeExperimentManager
        ledTransform = LED_CPU
    }

    MODULE
    {
        name = ModulePartVariants
        baseVariant = Gold
        useMultipleDragCubes = false

        VARIANT
        {
            name = Gold
            displayName = #LOC_Koffee_ExperimentManagerEML125_Variant_Gold
            themeName = Gold
            primaryColor = #fccb0a
            secondaryColor = #b38b24
            TEXTURE
            {
                materialName = CPU_MainBody
                shader = KSP/Bumped Specular
                mainTextureURL = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/CPU_Inline_Gold_Specular_RGBA
                _BumpMap = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/CPU_Inline_GoldSilver_Normal
            }
        }
        VARIANT
        {
            name = Silver
            displayName = #LOC_Koffee_ExperimentManagerEML125_Variant_Silver
            themeName = Silver
            primaryColor = #cecece
            secondaryColor = #969696
            TEXTURE
            {
                materialName = CPU_MainBody
                shader = KSP/Bumped Specular
                mainTextureURL = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/CPU_Inline_Silver_Specular_RGBA
                _BumpMap = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/CPU_Inline_GoldSilver_Normal
            }
        }
        VARIANT
        {
            name = White
            displayName = #LOC_Koffee_ExperimentManagerEML125_Variant_White
            themeName = White
            primaryColor = #ffffff
            secondaryColor = #cecece
            TEXTURE
            {
                materialName = CPU_MainBody
                shader = KSP/Bumped Specular
                mainTextureURL = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/CPU_Inline_White_Specular_RGBA
                _BumpMap = ShoAerospace/Koffee/Parts/Experiment_Manager_inLine/CPU_Inline_White_Normal
            }
        }
    }
}
