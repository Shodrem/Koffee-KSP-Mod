<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
    <KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
    <KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
    <ProjectReference Include="../Koffee/Koffee.csproj" Private="false" />
    <ModReference Include="BackgroundResourceProcessing">
      <DLLPath>GameData/BackgroundResourceProcessing/Plugins/BackgroundResourceProcessing.dll</DLLPath>
      <Private>false</Private>
    </ModReference>
  </ItemGroup>
</Project>
